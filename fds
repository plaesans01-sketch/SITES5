async def assign_verified(member, config):
    verified_role = member.guild.get_role(int(config.get("verified_role_id", 0)))
    pending_role = member.guild.get_role(int(config.get("pending_role_id", 0)))

    if verified_role is None:
        await log_event(member.guild, f"⚠️ Не удалось выдать Verified пользователю {member.mention}: роль Verified не настроена.")
        return False, "Роль подтверждённых участников не настроена."
    if pending_role is not None and pending_role.id == verified_role.id:
        await log_event(member.guild, "⚠️ Ошибка настройки: роли Pending и Verified не могут быть одной ролью.")
        return False, "Роли Pending и Verified должны быть разными."

    try:
        if verified_role not in member.roles:
            await member.add_roles(verified_role, reason="Verification completed")
            await log_event(member.guild, f"✅ Пользователю {member.mention} выдана роль {verified_role.mention}.")
        if pending_role is not None:
            had_pending = pending_role in member.roles
            await member.remove_roles(pending_role, reason="Verification completed")
            if had_pending:
                await log_event(member.guild, f"➖ У пользователя {member.mention} снята роль ожидания {pending_role.mention}.")
        else:
            await log_event(member.guild, "⚠️ Роль Pending не настроена или удалена с сервера.")
        return True, "Проверка успешно пройдена."
    except discord.Forbidden:
        await log_event(member.guild, f"❌ Ошибка ролей для {member.mention}: у бота недостаточно прав или роль бота расположена ниже целевой роли.")
        return False, "Бот не может управлять этими ролями. Проверь права и позицию роли."
    except discord.HTTPException as error:
        await log_event(member.guild, f"❌ Discord вернул ошибку при изменении ролей пользователя {member.mention}: {type(error).__name__}.")
        return False, "Discord не смог изменить роли."


def check_account_age(member, config):
    minimum = int(config.get("min_age_days", 0))
    if minimum <= 0:
        return True
    return (datetime.now(timezone.utc) - member.created_at).days >= minimum


async def classic_verify(interaction):
    if interaction.guild is None:
        await interaction.response.send_message(
            "Эта проверка доступна только на сервере.",
            ephemeral=True
        )
        return

    config = get_config(interaction.guild_id)
    await log_event(interaction.guild, f"🔎 Classic Verify: {interaction.user.mention} начал проверку.")
    if not check_account_age(interaction.user, config):
        await log_event(interaction.guild, f"❌ Classic Verify: {interaction.user.mention} не прошёл проверку возраста аккаунта.")
        await interaction.response.send_message(
            f"Возраст аккаунта должен быть не менее {config['min_age_days']} дней.",
            ephemeral=True
        )
        return

    success, message = await assign_verified(interaction.user, config)
    await log_event(interaction.guild, f"{'✅' if success else '❌'} Classic Verify: {interaction.user.mention} {'успешно прошёл' if success else 'не смог пройти'} проверку.")
    await interaction.response.send_message(message, ephemeral=True)


class RobloxUsernameModal(discord.ui.Modal, title="Roblox verification"):
    username = discord.ui.TextInput(
        label="Roblox username",
        placeholder="Введите имя пользователя Roblox",
        min_length=3,
        max_length=20
    )

    async def on_submit(self, interaction):
        if interaction.guild_id is None:
            await interaction.response.send_message(
                "Эта проверка доступна только на сервере.",
                ephemeral=True
            )
            return

        config = get_config(interaction.guild_id)
        if not check_account_age(interaction.user, config):
            await log_event(interaction.guild, f"❌ Roblox Verify: {interaction.user.mention} не прошёл проверку возраста аккаунта.")
            await interaction.response.send_message(
                f"Возраст аккаунта должен быть не менее {config['min_age_days']} дней.",
                ephemeral=True
            )
            return

        username = str(self.username).strip()
        await log_event(interaction.guild, f"🔎 Roblox Verify: {interaction.user.mention} начал проверку профиля Roblox **{discord.utils.escape_markdown(username)}**.")
        timeout = aiohttp.ClientTimeout(total=15)

        try:
            async with aiohttp.ClientSession(timeout=timeout) as session:
                async with session.post(
                    "https://users.roblox.com/v1/usernames/users",
                    json={"usernames": [username], "excludeBannedUsers": True}
                ) as response:
                    if response.status != 200:
                        await log_event(interaction.guild, f"⚠️ Roblox Verify: API вернул HTTP {response.status} при поиске профиля для {interaction.user.mention}.")
                        await interaction.response.send_message(
                            "Roblox временно недоступен. Попробуй позже.",
                            ephemeral=True
                        )
                        return
                    data = await response.json()

            results = data.get("data", [])
            if not results:
                await log_event(interaction.guild, f"❌ Roblox Verify: профиль **{discord.utils.escape_markdown(username)}** не найден для {interaction.user.mention}.")
                await interaction.response.send_message(
                    "Пользователь Roblox не найден.",
                    ephemeral=True
                )
                return

            roblox_user = results[0]
            code = "IRON-" + "".join(
                secrets.choice(string.ascii_uppercase + string.digits)
                for _ in range(8)
            )
            key = f"{interaction.guild_id}:{interaction.user.id}"

            roblox_challenges[key] = {
                "roblox_id": str(roblox_user["id"]),
                "username": roblox_user.get("name", username),
                "code": code,
                "created": datetime.now(timezone.utc).timestamp()
            }
            save_challenges()
            await log_event(interaction.guild, f"🧩 Roblox Verify: для {interaction.user.mention} создан код проверки профиля **{discord.utils.escape_markdown(roblox_user.get('name', username))}**.")

            embed = discord.Embed(
                title="Roblox verification",
                description=(
                    f"Открой профиль Roblox **{roblox_user.get('name', username)}** "
                    "и временно вставь этот код в описание профиля:\n\n"
                    f"```{code}```\n"
                    "Сохрани описание и нажми кнопку подтверждения."
                ),
                color=discord.Color.blurple()
            )
            await interaction.response.send_message(
                embed=embed,
                view=RobloxConfirmView(),
                ephemeral=True
            )

        except asyncio.TimeoutError:
