class TicketPanelView(discord.ui.View):
    def __init__(self, guild_id, config):
        super().__init__(timeout=None)
        self.guild_id = guild_id
        button = discord.ui.Button(
            label=config.get("ticket_button_label", "Create ticket"),
            style=discord.ButtonStyle.primary,
            custom_id=f"ironwall:{guild_id}:ticket_open"
        )
        button.callback = self.open_ticket
        self.add_item(button)

    async def open_ticket(self, interaction):
        if interaction.guild is None:
            await interaction.response.send_message("Тикеты доступны только на сервере.", ephemeral=True)
            return

        config = get_config(interaction.guild_id)
        required_id = int(config.get("ticket_required_role_id", 0))
        if required_id:
            required_role = interaction.guild.get_role(required_id)
            if required_role is None or required_role not in interaction.user.roles:
                await interaction.response.send_message(
                    "У тебя нет необходимой роли для создания тикета.",
                    ephemeral=True
                )
                return

        existing = discord.utils.find(
            lambda channel: isinstance(channel, discord.TextChannel)
            and channel.topic == f"ironwall-ticket-owner:{interaction.user.id}",
            interaction.guild.text_channels
        )
        if existing:
            await interaction.response.send_message(
                f"У тебя уже есть открытый тикет: {existing.mention}",
                ephemeral=True
            )
            return

        await interaction.response.defer(ephemeral=True, thinking=True)

        overwrites = {
            interaction.guild.default_role: discord.PermissionOverwrite(view_channel=False),
            interaction.user: discord.PermissionOverwrite(
                view_channel=True,
                send_messages=True,
                read_message_history=True,
                attach_files=True,
                embed_links=True
            ),
            interaction.guild.me: discord.PermissionOverwrite(
                view_channel=True,
                send_messages=True,
                read_message_history=True,
                manage_channels=True
            )
        }

        support_role_id = int(config.get("ticket_support_role_id", 0))
        support_role = interaction.guild.get_role(support_role_id) if support_role_id else None
        if support_role:
            overwrites[support_role] = discord.PermissionOverwrite(
                view_channel=True,
                send_messages=True,
                read_message_history=True,
                manage_messages=True
            )

        staff_ids = config.get("ticket_staff_user_ids", [])
        for staff_id in staff_ids:
            try:
                staff_member = interaction.guild.get_member(int(staff_id))
                if staff_member:
                    overwrites[staff_member] = discord.PermissionOverwrite(
                        view_channel=True,
                        send_messages=True,
                        read_message_history=True
                    )
            except (TypeError, ValueError):
                continue

        category_id = int(config.get("ticket_category_id", 0))
        category = interaction.guild.get_channel(category_id) if category_id else None
        if not isinstance(category, discord.CategoryChannel):
            category = None

        safe_name = re.sub(r"[^a-z0-9-]", "-", interaction.user.name.lower()).strip("-")[:18] or "user"
        channel_name = f"ticket-{safe_name}"[:90]

        try:
            ticket_channel = await interaction.guild.create_text_channel(
                name=channel_name,
                category=category,
                overwrites=overwrites,
                topic=f"ironwall-ticket-owner:{interaction.user.id}",
                reason=f"Ticket opened by {interaction.user}"
            )
            embed = discord.Embed(
                title=config.get("ticket_title", "Support ticket"),
                description=config.get("ticket_description", "Describe your issue here."),
                color=get_color(config.get("panel_color", "#5865F2"))
            )
            embed.add_field(name="Создатель", value=interaction.user.mention, inline=True)
            if support_role:
                embed.add_field(name="Команда поддержки", value=support_role.mention, inline=True)
            await ticket_channel.send(
                content=interaction.user.mention,
                embed=embed,
                view=TicketCloseView(),
                allowed_mentions=discord.AllowedMentions(users=True, roles=False, everyone=False)
            )
            await interaction.followup.send(
                f"Твой тикет создан: {ticket_channel.mention}",
                ephemeral=True
            )
        except discord.Forbidden:
            await interaction.followup.send(
                "Не удалось создать тикет. Выдай боту Manage Channels, View Channels и Send Messages.",
                ephemeral=True
            )
        except discord.HTTPException as error:
            print(f"Ticket creation error: {error}")
            await interaction.followup.send("Discord не смог создать канал тикета.", ephemeral=True)


class TicketCloseView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=None)

    @discord.ui.button(
        label="Закрыть тикет",
        style=discord.ButtonStyle.danger,
        custom_id="ironwall:ticket_close"
    )
    async def close_ticket(self, interaction, button):
        channel = interaction.channel
        if not isinstance(channel, discord.TextChannel) or not channel.topic or not channel.topic.startswith("ironwall-ticket-owner:"):
            await interaction.response.send_message("Эта команда работает только в тикете.", ephemeral=True)
            return

        owner_id = int(channel.topic.split(":", 1)[1])
        is_owner = interaction.user.id == owner_id
        can_manage = interaction.user.guild_permissions.manage_channels
        config = get_config(interaction.guild_id)
        support_role_id = int(config.get("ticket_support_role_id", 0))
        is_support = any(role.id == support_role_id for role in interaction.user.roles) if support_role_id else False

        if not (is_owner or can_manage or is_support):
            await interaction.response.send_message("Закрыть тикет может только его создатель или поддержка.", ephemeral=True)
            return

        await interaction.response.send_message("Тикет будет закрыт через 3 секунды.", ephemeral=True)
        await asyncio.sleep(3)
        try:
            await channel.delete(reason=f"Ticket closed by {interaction.user}")
        except (discord.Forbidden, discord.HTTPException) as error:
            print(f"Ticket close error: {error}")


