class RobloxConfirmView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=300)

    @discord.ui.button(label="Подтвердить профиль Roblox", style=discord.ButtonStyle.success)
    async def confirm(self, interaction, button):
        if interaction.guild_id is None:
            await interaction.response.send_message(
                "Эта проверка доступна только на сервере.",
                ephemeral=True
            )
            return

        key = f"{interaction.guild_id}:{interaction.user.id}"
        challenge = roblox_challenges.get(key)

        if not challenge:
            await log_event(interaction.guild, f"⚠️ Roblox Verify: {interaction.user.mention} нажал подтверждение без активной проверки.")
            await interaction.response.send_message(
                "Активная проверка не найдена. Начни заново.",
                ephemeral=True
            )
            return

        if datetime.now(timezone.utc).timestamp() - challenge["created"] > 900:
            roblox_challenges.pop(key, None)
            save_challenges()
            await log_event(interaction.guild, f"⌛ Roblox Verify: код для {interaction.user.mention} истёк.")
            await interaction.response.send_message(
                "Код истёк. Начни проверку заново.",
                ephemeral=True
            )
            return

        try:
            await log_event(interaction.guild, f"🔍 Roblox Verify: {interaction.user.mention} проверяет код для профиля **{discord.utils.escape_markdown(challenge.get('username', 'Roblox'))}**.")
            timeout = aiohttp.ClientTimeout(total=15)
            async with aiohttp.ClientSession(timeout=timeout) as session:
                async with session.get(
                    f"https://users.roblox.com/v1/users/{challenge['roblox_id']}"
                ) as response:
                    if response.status != 200:
                        await log_event(interaction.guild, f"⚠️ Roblox Verify: не удалось открыть профиль для {interaction.user.mention}, HTTP {response.status}.")
                        await interaction.response.send_message(
                            "Не удалось открыть профиль Roblox.",
                            ephemeral=True
                        )
                        return
                    profile = await response.json()

            if challenge["code"] not in (profile.get("description") or ""):
                await log_event(interaction.guild, f"❌ Roblox Verify: неверный код в профиле **{discord.utils.escape_markdown(challenge.get('username', 'Roblox'))}** для {interaction.user.mention}.")
                await interaction.response.send_message(
                    "Код не найден в описании профиля. Сохрани его и попробуй снова.",
                    ephemeral=True
                )
                return

            config = get_config(interaction.guild_id)
            if not check_account_age(interaction.user, config):
                await log_event(interaction.guild, f"❌ Roblox Verify: {interaction.user.mention} не прошёл проверку возраста аккаунта.")
                await interaction.response.send_message(
                    f"Возраст аккаунта должен быть не менее {config['min_age_days']} дней.",
                    ephemeral=True
                )
                return

            success, message = await assign_verified(interaction.user, config)
            if success:
                roblox_challenges.pop(key, None)
                save_challenges()
                await log_event(interaction.guild, f"✅ Roblox Verify: {interaction.user.mention} успешно подтвердил профиль **{discord.utils.escape_markdown(challenge.get('username', 'Roblox'))}**.")
            else:
                await log_event(interaction.guild, f"❌ Roblox Verify: не удалось завершить проверку для {interaction.user.mention}: {discord.utils.escape_markdown(message)}")
            await interaction.response.send_message(message, ephemeral=True)

        except asyncio.TimeoutError:
            await log_event(interaction.guild, f"⚠️ Roblox Verify: тайм-аут при подтверждении профиля для {interaction.user.mention}.")
            await interaction.response.send_message(
                "Запрос к Roblox превысил время ожидания.",
                ephemeral=True
            )
        except Exception as error:
            print(f"Roblox confirmation error: {type(error).__name__}: {error}")
            await log_event(interaction.guild, f"❌ Roblox Verify: ошибка подтверждения профиля для {interaction.user.mention}: {type(error).__name__}.")
            if not interaction.response.is_done():
                await interaction.response.send_message(
                    "Не удалось завершить проверку.",
                    ephemeral=True
                )


