@verify_bot.event
async def on_member_join(member):
    config = get_config(member.guild.id)
    await log_event(member.guild, f"👤 Новый участник: {member.mention} (`{member.id}`) присоединился к серверу.")
    used_invite = None
    try:
        current_invites = await member.guild.invites()
        previous = invite_cache.get(member.guild.id, {})
        for invite in current_invites:
            old_uses = previous.get(invite.code, (0, None))[0]
            if (invite.uses or 0) > old_uses:
                used_invite = invite
                break
        invite_cache[member.guild.id] = {
            invite.code: (invite.uses or 0, invite.inviter) for invite in current_invites
        }
    except (discord.Forbidden, discord.HTTPException):
        pass
    if used_invite:
        await audit_log(member.guild, f"📨 {audit_user(member)} зашёл по приглашению `{used_invite.code}` от {audit_user(used_invite.inviter)}. Использований: {used_invite.uses}.")
    else:
        await audit_log(member.guild, f"📥 Новый участник: {audit_user(member)}. Кто пригласил: определить не удалось.")
    role = member.guild.get_role(int(config.get("pending_role_id", 0)))
    if role is None:
        await log_event(member.guild, f"⚠️ Для {member.mention} не выдана роль Pending: роль не настроена.")
        return
    try:
        await member.add_roles(role, reason="Waiting for verification")
        await log_event(member.guild, f"⏳ Пользователю {member.mention} выдана роль ожидания {role.mention}.")
        await audit_log(member.guild, f"🎭 Пользователю {audit_user(member)} выдана роль {role.mention}.")
    except discord.Forbidden:
        await log_event(member.guild, f"❌ Не удалось выдать Pending пользователю {member.mention}: недостаточно прав или роль бота ниже роли Pending.")
    except discord.HTTPException as error:
        await log_event(member.guild, f"❌ Ошибка Discord при выдаче Pending пользователю {member.mention}: {type(error).__name__}.")


