def make_chunks(lines, limit=1800):
    chunks = []
    current = "—"
    for line in lines:
        addition = line + "\n"
        if len(current) + len(addition) > limit and current:
            chunks.append(current.rstrip())
            current = "—"
        current += addition
    if current:
        chunks.append(current.rstrip())
    return chunks


async def delete_command_message(ctx):
    if ctx.interaction is None and ctx.message:
        try:
            await ctx.message.delete()
        except (discord.Forbidden, discord.NotFound, discord.HTTPException):
            pass


async def send_private_ctx(ctx, content=None, **kwargs):
    if ctx.interaction is not None:
        if ctx.interaction.response.is_done():
            return await ctx.interaction.followup.send(content, ephemeral=True, **kwargs)
        return await ctx.interaction.response.send_message(content, ephemeral=True, **kwargs)
    try:
        return await ctx.author.send(content, **kwargs)
    except (discord.Forbidden, discord.HTTPException):
        return None


async def send_repeated(ctx, content, repeat, column=1, require_manage_messages=False):
    await delete_command_message(ctx)

    if require_manage_messages:
        if ctx.guild is None:
            await send_private_ctx(ctx, "Эта команда доступна только на сервере.")
            return
        if not ctx.author.guild_permissions.manage_messages:
            await send_private_ctx(ctx, "Нужно разрешение Manage Messages.")
            return

    if not content or not content.strip():
        await send_private_ctx(ctx, "Укажи текст или ссылку.")
        return
    if repeat < 1 or repeat > 5:
        await send_private_ctx(ctx, "Количество отдельных сообщений должно быть от 1 до 5.")
        return
    if column < 1:
        await send_private_ctx(ctx, "Количество строк должно быть не меньше 1.")
        return

    max_lines = (2001 // (len(content) + 1))
    if column > max_lines:
        await send_private_ctx(
            ctx,
            f"Превышен лимит символов. Можно: **{max_lines}** строк(и) в столбик. "
            f"В одной строке {len(content)} символов, лимит Discord — 2000 символов."
        )
        return

    message_content = "\n".join([content] * column)

    allowed_mentions = discord.AllowedMentions.none()

    if ctx.interaction is not None:
        interaction = ctx.interaction
        await interaction.response.defer(ephemeral=True, thinking=True)
        try:
            for _ in range(repeat):
                await interaction.followup.send(
                    message_content,
                    ephemeral=False,
                    allowed_mentions=allowed_mentions
                )
            await interaction.edit_original_response(content="Сообщение отправлено публично.")
        except (discord.Forbidden, discord.HTTPException) as error:
            print(f"Public message send error: {type(error).__name__}: {error}")
            try:
                await interaction.edit_original_response(content="Не удалось отправить сообщение. Проверь права бота и повтори попытку.")
            except (discord.NotFound, discord.Forbidden, discord.HTTPException):
                pass
    else:
        first_message = await ctx.send(
            message_content,
            allowed_mentions=allowed_mentions
        )
        try:
            await first_message.delete()
        except (discord.NotFound, discord.Forbidden, discord.HTTPException):
            pass
        for _ in range(repeat):
            await ctx.send(
                message_content,
                allowed_mentions=allowed_mentions
            )


