@verify_bot.hybrid_command(name="users", description="—")
async def users(ctx):
    if ctx.guild is None:
        await send_private_ctx(ctx, "Команда доступна только на сервере.")
        return

    if ctx.interaction is not None:
        await ctx.defer(ephemeral=True)

    try:
        names = []
        async for member in ctx.guild.fetch_members(limit=None):
            if not member.bot:
                display_name = member.display_name.replace("\r", " ").replace("\n", " ").strip()
                names.append(display_name or member.name)

        names.sort(key=str.casefold)
        if not names:
            await send_private_ctx(ctx, "Участники не найдены.")
            return

        content = "\n".join(names)
        file = discord.File(io.BytesIO(content.encode("utf-8")), filename="members.txt")
        if ctx.interaction is not None:
            await ctx.send(
                content=f"Участников: {len(names)}. Список ников в TXT-файле.",
                file=file,
                ephemeral=True,
                allowed_mentions=discord.AllowedMentions.none()
            )
        else:
            try:
                await ctx.author.send(
                    content=f"Участников: {len(names)}. Список ников в TXT-файле.",
                    file=file,
                    allowed_mentions=discord.AllowedMentions.none()
                )
            except (discord.Forbidden, discord.HTTPException):
                return
    except discord.Forbidden:
        await send_private_ctx(ctx, "Не удалось получить участников. Включи Server Members Intent в Discord Developer Portal.")
    except discord.HTTPException as error:
        print(f"users command error: {type(error).__name__}: {error}")
        await send_private_ctx(ctx, "Discord не смог получить список участников.")
    except Exception as error:
        print(f"users command error: {type(error).__name__}: {error}")
        await send_private_ctx(ctx, "Не удалось сформировать список участников.")


async def encrypt_guild_members(guild, channel, interval_seconds):
    current_task = asyncio.current_task()
    guild_key = str(guild.id)
    saved = encrypted_nicknames.setdefault(guild_key, {})
    alphabet = string.ascii_letters + string.digits + "!@#$%^&*_-+="
    cycle = 0

    try:
        while True:
            cycle += 1
            changed = 0
            failed = 0

            async for member in guild.fetch_members(limit=None):
                if member.bot or member.id == guild.owner_id:
                    continue

                saved.setdefault(str(member.id), member.nick)
                save_encrypted_nicknames()

                nickname = "—".join(secrets.choice(alphabet) for _ in range(secrets.randbelow(11) + 5))
                try:
                    await member.edit(
                        nick=nickname,
                        reason="Periodic nickname randomization requested by a server administrator"
                    )
                    changed += 1
                except discord.Forbidden:
                    failed += 1
                except discord.HTTPException as error:
                    failed += 1
                    if error.status == 429:
                        retry_after = getattr(error, "retry_after", 5)
                        await asyncio.sleep(max(1, float(retry_after)))

                await asyncio.sleep(1)

            print(f"Encrypt cycle {cycle} for guild {guild.id}: changed={changed}, failed={failed}")
            if cycle == 1:
                await channel.send(
                    f"Первое обновление завершено. Изменено: {changed}. Не удалось: {failed}. "
                    f"Следующее обновление через {interval_seconds // 60} мин."
                )

            await asyncio.sleep(interval_seconds)
    except asyncio.CancelledError:
        raise
    except Exception as error:
        print(f"Encrypt command error: {type(error).__name__}: {error}")
        try:
            await channel.send("Автоматическое обновление ников остановлено из-за ошибки. Проверь права бота и Server Members Intent.")
        except (discord.Forbidden, discord.HTTPException):
            pass
    finally:
        if encrypt_tasks.get(guild.id) is current_task:
            encrypt_tasks.pop(guild.id, None)


async def restore_guild_nicknames(guild, channel):
    guild_key = str(guild.id)
    saved = encrypted_nicknames.get(guild_key, {})
    if not saved:
        await channel.send("Сохранённые ники для восстановления не найдены.")
        return

    restored = 0
    failed = 0
    async for member in guild.fetch_members(limit=None):
        key = str(member.id)
        if key not in saved or member.bot or member.id == guild.owner_id:
            continue
        try:
            await member.edit(nick=saved[key], reason="Restore nicknames saved by /encrypt")
            restored += 1
            saved.pop(key, None)
        except (discord.Forbidden, discord.HTTPException):
            failed += 1

    if not saved:
        encrypted_nicknames.pop(guild_key, None)
    save_encrypted_nicknames()
    await channel.send(f"Восстановление завершено. Восстановлено: {restored}. Не удалось: {failed}.")


class EncryptConfirmView(discord.ui.View):
    def __init__(self, guild, requester_id, interval_seconds):
        super().__init__(timeout=60)
        self.guild = guild
        self.requester_id = requester_id
        self.interval_seconds = interval_seconds

    @discord.ui.button(label="Подтвердить", style=discord.ButtonStyle.danger)
    async def confirm(self, interaction, button):
        if interaction.user.id != self.requester_id:
            await interaction.response.send_message("Подтвердить может только автор команды.", ephemeral=True)
            return
        if self.guild.id in encrypt_tasks and not encrypt_tasks[self.guild.id].done():
            await interaction.response.edit_message(content="Автоматическое обновление уже запущено.", view=None)
            return
        minutes = self.interval_seconds // 60
        await interaction.response.edit_message(
            content=f"Автоматическое изменение ников запущено. Интервал: {minutes} мин. Для остановки используй /decrypt.",
            view=None
        )
        task = asyncio.create_task(
            encrypt_guild_members(self.guild, interaction.channel, self.interval_seconds)
        )
        encrypt_tasks[self.guild.id] = task

    @discord.ui.button(label="Отмена", style=discord.ButtonStyle.secondary)
    async def cancel(self, interaction, button):
        if interaction.user.id != self.requester_id:
            await interaction.response.send_message("Отменить может только автор команды.", ephemeral=True)
            return
        await interaction.response.edit_message(content="Отменено.", view=None)
        self.stop()


