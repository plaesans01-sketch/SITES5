            await main_bot.tree.sync()
            main_synced = True
        except discord.HTTPException as error:
            print(f"Main command sync error: {error}")
    print(f"Основной бот запущен: {main_bot.user}")


async def run_one(bot, token, label):
    try:
        await bot.start(token)
    except asyncio.CancelledError:
        raise
    except discord.LoginFailure:
        print(f"{label}: неверный токен. Проверь токен в начале main.py.")
        raise
    except Exception as error:
        print(f"{label}: ошибка запуска: {type(error).__name__}: {error}")
        raise


async def run_bots():
    missing = []
    if not APP_BOT_TOKEN or APP_BOT_TOKEN.startswith("ВСТАВЬ_"):
        missing.append("APP_BOT_TOKEN")
    if not VERIFY_BOT_TOKEN or VERIFY_BOT_TOKEN.startswith("ВСТАВЬ_"):
        missing.append("VERIFY_BOT_TOKEN")
    if ADMIN_ID <= 0:
        missing.append("ADMIN_ID")

    if missing:
        print("Не заполнены настройки: " + ", ".join(missing))
        print("Открой начало main.py и укажи значения. Программа остановлена без traceback.")
        return

    await asyncio.gather(
        run_one(main_bot, APP_BOT_TOKEN, "Основной бот"),
        run_one(verify_bot, VERIFY_BOT_TOKEN, "Verify-бот")
    )


if __name__ == "__main__":
    try:
        asyncio.run(run_bots())
    except KeyboardInterrupt:
        print("Остановка ботов.")
