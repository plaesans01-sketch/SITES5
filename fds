async def glitch_loop(interaction, channel_id, messages, first_text, second_text, interval):
    current_task = asyncio.current_task()
    deadline = interaction.expires_at.timestamp() - 10
    next_text = second_text

    try:
        while datetime.now(timezone.utc).timestamp() + interval < deadline:
            await asyncio.sleep(interval)
            if datetime.now(timezone.utc).timestamp() >= deadline:
                break

            for message in messages:
                try:
                    await interaction.followup.edit_message(
                        message.id,
                        content=next_text,
                        allowed_mentions=discord.AllowedMentions.none()
                    )
                except discord.NotFound:
                    continue

            next_text = first_text if next_text == second_text else second_text
    except asyncio.CancelledError:
        raise
    except (discord.Forbidden, discord.HTTPException) as error:
        print(f"Glitch stopped in channel {channel_id}: {type(error).__name__}: {error}")
    except Exception as error:
        print(f"Glitch unexpected error in channel {channel_id}: {type(error).__name__}: {error}")
    finally:
        if glitch_tasks.get(channel_id) is current_task:
            glitch_tasks.pop(channel_id, None)


@main_bot.tree.command(name="glitch", description="—")
@app_commands.describe(text="—", new_text="—", interval="—")
async def glitch(
    interaction: discord.Interaction,
    text: str,
    new_text: str,
    interval: app_commands.Range[int, 1, 3600]
):
    if interaction.guild is None or interaction.channel is None:
        await interaction.response.send_message("Эта команда доступна только на сервере.", ephemeral=True)
        return

    if interaction.channel_id in glitch_tasks:
        await interaction.response.send_message("В этом канале уже запущен Glitch. Используй /stop.", ephemeral=True)
        return

    first_text = text.strip()
    second_text = new_text.strip()
    if not first_text or not second_text:
        await interaction.response.send_message("Оба текста должны быть заполнены.", ephemeral=True)
        return
    if len(first_text) > 2000 or len(second_text) > 2000:
        await interaction.response.send_message("Каждый текст должен помещаться в одно сообщение Discord.", ephemeral=True)
        return

    await interaction.response.defer(ephemeral=True, thinking=True)
    messages = []
    try:
        for _ in range(5):
            message = await interaction.followup.send(
                first_text,
                wait=True,
                ephemeral=False,
                allowed_mentions=discord.AllowedMentions.none()
            )
            messages.append(message)
    except (discord.Forbidden, discord.HTTPException) as error:
        print(f"Glitch start error: {type(error).__name__}: {error}")
        await interaction.edit_original_response(content="Не удалось отправить все пять сообщений.")
        return

    await interaction.edit_original_response(content="Glitch запущен. Для остановки используй /stop.")
    task = asyncio.create_task(
        glitch_loop(interaction, interaction.channel_id, messages, first_text, second_text, interval)
    )
    glitch_tasks[interaction.channel_id] = task


@main_bot.hybrid_command(name="stop", description="—")
async def stop_glitch(ctx):
    if ctx.channel is None:
        await send_private_ctx(ctx, "Канал не найден.")
        return

    task = glitch_tasks.pop(ctx.channel.id, None)
    if task is None or task.done():
        await send_private_ctx(ctx, "В этом канале нет активного Glitch.")
        return

    task.cancel()
    await send_private_ctx(ctx, "Glitch остановлен.")


